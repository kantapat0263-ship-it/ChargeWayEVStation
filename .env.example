# ===== ChargeWay — Environment Variables =====
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env.local จะไม่ถูก commit)
# บน Vercel ให้ตั้งค่าใน Project Settings → Environment Variables

# Google Maps JavaScript API key (ใช้ฝั่ง client — จะมองเห็นได้ในเบราว์เซอร์เสมอ)
# ความปลอดภัยที่แท้จริงคือการจำกัดสิทธิ์ key ใน Google Cloud Console:
#   1) Application restrictions → HTTP referrers → ใส่โดเมนของคุณ
#      เช่น  https://charge-way-ev-station.vercel.app/*  และ  http://localhost:9002/*
#      (npm run dev รันที่พอร์ต 9002 ไม่ใช่ 3000)
#   2) API restrictions → จำกัดเฉพาะ: Maps JavaScript API, Places API (New), Places API, Geocoding API, Directions API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# (ไม่บังคับ) Crash reporting ด้วย Sentry — สมัครฟรีที่ https://sentry.io แล้วเอา DSN มาใส่
# ไม่ตั้งค่า = ปิดการรายงาน error โดยสมบูรณ์
NEXT_PUBLIC_SENTRY_DSN=
